# --- virtualenv ---
.venv/
venv/
env/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- raw data (large, re-downloadable, never committed) ---
# Use a wildcard, not the directory itself: git does not descend into an
# ignored directory, so "data/raw/" would make the negation below unreachable.
data/raw/*
!data/raw/.gitkeep

# --- fitted models (regenerable, and rule 5 says they never ship) ---
# models/tfidf.joblib is the vectoriser behind /check's similar-headlines search.
# Rebuilt by `python -m dwm build`; committing it would add a binary blob that
# silently drifts from the corpus it was fitted on.
models/
*.joblib
*.pkl

# --- warehouse (large binary) ---
warehouse/*.duckdb
warehouse/*.duckdb.wal
warehouse/*.wal
# The copy `dwm serve` reads from, so the API can hold a lock without blocking
# the CLI. Rebuilt on demand; never worth committing 424 MB of.
warehouse/dwm.serve.duckdb

# --- generated artefacts ---
# `mining.json` is the large intermediate and is fully regenerable, so it is
# ignored. `facts.json` and `report.md` are also regenerable, but they are the
# *published results*, and they are committed so that anyone who opens the
# repository sees what the study found without installing anything or waiting
# six minutes for the pipeline. A results snapshot that can drift from the code
# is the risk here; the snapshot is regenerated in the same commit as any change
# that moves a number, and `dwm report` refuses to run with a failing gate.
reports/mining.json
reports/*.log

# Everything else under reports/ is generated and not published.
reports/*.tmp

# --- screenshots and scratch ---
# Win+Shift+S creates a *directory* of this name containing timestamped PNGs.
_shot.png/
_shot*.png
_screens/
*.local.md

# Scratch space for throwaway audit/export scripts and intermediate dumps.
# `sql/schema.sql` is regenerated by exporting here, then the dump is deleted.
tmp/

logs/
*.log
!pip-install.log

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
